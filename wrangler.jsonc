{
  "name": "shelldex-com",
  "compatibility_date": "2026-07-18",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "shelldex.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
