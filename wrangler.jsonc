{
  "name": "shelldex-com",
  "main": "./src/worker-entry.js",
  "compatibility_date": "2026-07-18",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "shelldex.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/leaderboard", "/leaderboard/*", "/projects/*", "/compare/*", "/alternatives/*", "/api/projects/*", "/api/compare/*", "/md/projects/*", "/md/compare/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
