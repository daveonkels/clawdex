---
import Layout from '../layouts/Layout.astro';
import DataStamp from '../components/DataStamp.astro';
import HostingChooser from '../components/HostingChooser.astro';
import { loadProjects } from '../lib/projects';
import { loadLeaderboard } from '../lib/compare';
import { buildEditorial } from '../lib/editorial';
import { agentFaq } from '../lib/agent-faq';
const projects = await loadProjects();
const { entries, generated } = loadLeaderboard();
const editorial = buildEditorial(projects, entries, generated);
const groups = agentFaq(editorial, projects.length);
const title = 'Your first AI agent: setup, hosting, cost & privacy | Shelldex FAQ';
const description = 'What should you ask an AI agent to do first? Try a small task, choose where it runs, and learn what it can see, send and spend.';
const jsonLd = { '@context':'https://schema.org', '@type':'FAQPage', name:'Your first AI agent', description, url:'https://shelldex.com/faq/',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Shelldex', item: 'https://shelldex.com/' },
      { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://shelldex.com/faq/' },
    ],
  },
  mainEntity: groups.flatMap(group => group.items.map(item => ({
  '@type':'Question', name:item.q, url:'https://shelldex.com/faq/#'+item.id, acceptedAnswer:{'@type':'Answer',text:item.a}
}))) };
---
<Layout {title} {description} {jsonLd} ogImage="https://shelldex.com/images/faq-first-task.webp" ogImageWidth={720} ogImageHeight={480} ogImageAlt="A lobster assistant sorts receipts while a person checks its work.">
  <div class="max-w-[72rem] mx-auto px-5 sm:px-8"><article class="guide">
    <header class="intro">
      <div><p class="kicker">Shelldex field guide · FAQ</p>
        <h1>Your first AI agent</h1>
        <p class="lede">Start with a job you already know how to do. If an assistant can turn a pile of receipts into a list you can trust, then it’s worth asking what else you’d like it to handle.</p>
        <a class="sd-primary mt-4" href="#first-task">Try a first task <span aria-hidden="true">↓</span></a>
      </div>
      <img src="/images/faq-first-task.webp" width="720" height="480" alt="A lobster assistant sorts receipts into a folder while a person checks one by hand." />
    </header>
    <nav class="chapters" aria-label="FAQ sections"><span>In this guide</span>{groups.map(g => <a href={'#'+g.id}>{g.label}</a>)}</nav>
    {groups.map((group,i) => <section id={group.id}>
      <p class="kicker">Chapter 0{i+1}</p><h2>{group.label}</h2><p class="deck">{group.intro}</p>
      {group.id === 'technical' && <HostingChooser />}
      {group.id === 'ecosystem-shelldex' && <DataStamp date={generated}><span data-editorial="snapshotNotice">{editorial.snapshotNotice}</span></DataStamp>}
      {group.items.map((item,j) => <details id={item.id} open={group.id === 'general' && j===0}>
        <summary>{item.q}</summary>
        <div class="answer"><p data-editorial={item.metric}>{item.a}</p>
          <div class="links">{item.link && <a href={item.link[1]}>{item.link[0]} <span aria-hidden="true">↗</span></a>}
            {item.id === 'first-task' && <a href="/ideas/">Find a recipe for your own agent</a>}
            <a href={'#'+item.id} class="permalink" aria-label={'Link to: '+item.q}>Link to this answer</a>
          </div>
        </div>
      </details>)}
    </section>)}
  </article></div>
  <script>
    const reveal = () => {
      const item = document.getElementById(location.hash.slice(1));
      if (item instanceof HTMLDetailsElement && !item.open) { item.open = true; item.scrollIntoView({block:'start'}); }
    };
    reveal(); window.addEventListener('hashchange', reveal);
  </script>
</Layout>
<style>
.guide{width:100%;padding:1.5rem 0;color:#241e19}
.intro{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);align-items:center;gap:clamp(1rem,3vw,2rem);margin:1.5rem 0}
.kicker,.chapters>span{font:650 .76rem/1.4 ui-monospace,monospace;text-transform:uppercase;letter-spacing:.12em;color:#82422f}
.intro h1{margin:.75rem 0}
.intro img{width:100%;height:auto;border-radius:.9rem}.lede,.deck{color:#5d5147;line-height:1.55}.lede{font-size:1.08rem}
.chapters{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem 1rem;padding:1rem 0;border-top:1px solid #d7cbbb;border-bottom:1px solid #d7cbbb}
.chapters a,.links a{display:inline-flex;align-items:center;min-height:44px;color:#342b24;text-decoration:underline;text-underline-offset:.2em;font-size:.88rem}
section{margin:clamp(2.25rem,5vw,3.8rem) 0;scroll-margin-top:5rem}.guide h2{margin:.45rem 0}.deck{margin:0 0 1.1rem}
details{background:#fffdf9;border:1px solid #dfd6c9;border-radius:.6rem;margin:.5rem 0;scroll-margin-top:5rem}details[open]{border-color:#9f8e7f}
summary{display:flex;align-items:center;justify-content:space-between;gap:.7rem;padding:1rem 1.15rem;cursor:pointer;font-weight:625;list-style:none}summary::-webkit-details-marker{display:none}
summary:after{content:'+';font:1.3rem/1 monospace;color:#67594e}details[open]>summary:after{content:'−'}
.answer{padding:0 1.15rem 1.1rem}.answer p{line-height:1.67;max-width:75ch;color:#50483e}.links{margin-top:.65rem;display:flex;align-items:center;flex-wrap:wrap;gap:.65rem 1.3rem}.links .permalink{font-size:.75rem;color:#675d53}
.snapshot{font-size:.85rem;margin:1rem 0;color:#655a50}
@media(max-width:640px){.intro{grid-template-columns:1fr}.intro img{max-width:24rem;justify-self:center}.chapters{gap:.6rem .9rem}}
</style>
