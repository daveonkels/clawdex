---
import Layout from '../layouts/Layout.astro';
import DataStamp from '../components/DataStamp.astro';
import MomentumSparkline from '../components/MomentumSparkline.astro';
import { verifiedSetup } from '../lib/agent-choice';
import { languageLabel } from '../lib/constants';
import { loadProjects, getUniqueLanguages, formatStars } from '../lib/projects';
import { loadLeaderboard, getIndexableComparePairs } from '../lib/compare';

const projects = await loadProjects();
const { generated } = loadLeaderboard();
const available = projects.filter(p => p.github_data?.availability !== 'unavailable' && p.status !== 'archived');
const unavailable = projects.filter(p => p.github_data?.availability === 'unavailable' || p.status === 'archived');
const directory = [...available, ...unavailable];
const otherAgentCount = directory.filter(p => p.slug !== 'openclaw' && p.slug !== 'hermes').length;
const languages = getUniqueLanguages(projects);
const totalStars = available.reduce((sum, p) => sum + (p.stars ?? 0), 0);
const projectMap = new Map(available.map(p => [p.slug, p]));
const comparisons = getIndexableComparePairs(projects);
const featuredPairs = ['hermes-vs-openclaw','astrbot-vs-openclaw','nullclaw-vs-zeroclaw']
  .map(id => comparisons.find(pair => pair.canonical === id))
  .filter(pair => pair && projectMap.has(pair.slugA) && projectMap.has(pair.slugB));
const situations = [
  { key: 'desk', label:'At my desk', platforms:['desktop','browser','cli'] },
  { key: 'always-on', label:'On an always-on computer', platforms:['server','serverless','cloud'] },
  { key: 'phone', label:'On my phone', platforms:['mobile'] },
  { key: 'chat', label:'In a chat app', platforms:['messaging'] },
  { key: 'tiny', label:'On tiny hardware', platforms:['embedded','edge'] },
];
const setupsBySlug = new Map(projects.map(p => [p.slug, verifiedSetup(p)]));
const usesBySlug = new Map(projects.map(p => {
  const setup = setupsBySlug.get(p.slug)?.setup;
  const uses = situations.filter(s =>
    p.platform?.some(platform => s.platforms.includes(platform)) ||
    (s.key === 'desk' && (setup === 'Desktop installer' || setup === 'Command line')));
  return [p.slug, uses.map(s => s.key)];
}));
const chooserTiles = [
  { key: 'desk', label: 'At my desk' },
  { key: 'always-on', label: 'Always on' },
  { key: 'chat', label: 'In a chat app' },
  { key: 'tiny', label: 'Tiny hardware' },
].map(tile => ({
  ...tile,
  count: directory.filter(project => usesBySlug.get(project.slug)?.includes(tile.key)).length,
}));
const title = 'Find a personal AI agent: OpenClaw, Hermes and alternatives | Shelldex';
const description = 'Find a runnable personal AI agent for your computer, phone or chat app. Compare how agents run, see their activity and try a first task.';
const topAgents = available.slice(0, 10);
const json = [
  {'@context':'https://schema.org','@type':'WebSite','@id':'https://shelldex.com/#website',name:'Shelldex',url:'https://shelldex.com/',description,
    potentialAction:{'@type':'SearchAction',target:'https://shelldex.com/?q={search_term_string}#directory','query-input':'required name=search_term_string'}},
  {'@context':'https://schema.org','@type':'Dataset','@id':'https://shelldex.com/#dataset',name:'Shelldex agent directory',description,
    url:'https://shelldex.com/',license:'https://creativecommons.org/licenses/by/4.0/',creator:{'@type':'Person',name:'Dave Onkels',url:'https://onk.io'},
    distribution:[{ '@type':'DataDownload',encodingFormat:'application/json',contentUrl:'https://shelldex.com/api/projects.json' },
      { '@type':'DataDownload',encodingFormat:'application/json',contentUrl:'https://shelldex.com/api/leaderboard.json' },
      { '@type':'DataDownload',encodingFormat:'text/plain',contentUrl:'https://shelldex.com/llms-full.txt' },
      { '@type':'DataDownload',encodingFormat:'text/markdown',contentUrl:'https://shelldex.com/md/index.md' }],
    variableMeasured: ['stars', 'forks', 'open_issues', 'star_growth_7d', 'last_commit', 'license', 'language']},
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Personal AI agents with the most GitHub stars',
    numberOfItems: topAgents.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: topAgents.map((project, index) => ({
      '@type': 'ListItem', position: index + 1, name: project.name,
      url: `https://shelldex.com/projects/${project.slug}/`,
    })),
  },
];
---
<Layout title={title} description={description} markdownUrl="https://shelldex.com/md/index.md" jsonUrl="https://shelldex.com/api/projects.json" jsonLd={json}>
  <section class="wrap hero" aria-labelledby="home-title">
    <div class="hero-top">
      <div class="hero-copy">
        <p class="eyebrow">Every shell in the sea</p>
        <h1 id="home-title">Compare OpenClaw, Hermes, and {otherAgentCount} other AI agents<span class="text-ledger-red">.</span></h1>
        <p class="intro">A comprehensive directory of personal, self-hosted AI agents for nearly every use case.</p>
        <div class="hero-metrics">
          <span>{formatStars(totalStars)} GitHub stars across {available.length} available agents</span>
          <span>{getUniqueLanguages(available).length} languages</span>
          {generated && <DataStamp date={generated} />}
        </div>
      </div>
      <img class="hero-art" src="/images/home/tide-table.webp"
        srcset="/images/home/tide-table-small.webp 560w, /images/home/tide-table.webp 1120w"
        sizes="(max-width: 639px) calc(100vw - 40px), (max-width: 1152px) 49vw, 550px"
        width="1120" height="560" fetchpriority="high"
        alt="The lobster archivist arranges three shell specimens beside an open field notebook at the shore." />
    </div>
    <nav class="chooser" aria-labelledby="chooser-title">
      <h2 id="chooser-title">Where will yours live?</h2>
      <div class="chooser-grid">
        {chooserTiles.map(tile => <a class="place" href={'/?use=' + tile.key + '#directory'}>
          <span class="place-art"><img src={'/images/home/' + tile.key + '.webp'} width="432" height="288" alt="" /></span>
          <span class="place-copy"><strong>{tile.label}</strong><small>{tile.count} {tile.count === 1 ? 'agent' : 'agents'}</small></span>
        </a>)}
        <a class="browse-all" href="/#directory"><small>Not sure yet?</small><strong>Browse all {directory.length} <span aria-hidden="true">→</span></strong></a>
      </div>
    </nav>
  </section>

  <section id="directory" class="wrap directory" aria-labelledby="directory-title">
    <header class="section-head">
      <h2 id="directory-title">Agent directory</h2>
    </header>
    <fieldset id="use-filters" class="filters">
      <legend>Where do you want to use it?</legend>
      <div class="chip-strip">{[{key:'all',label:'Anywhere'}, ...situations].map(s =>
        <button type="button" class="chip" data-use={s.key} aria-pressed={s.key === 'all' ? 'true' : 'false'}><span class="check" aria-hidden="true">✓</span>{s.label}</button>
      )}</div>
    </fieldset>
    <div class="search-controls">
      <label>Search agents<input type="search" id="v2-search" placeholder="Name or feature, e.g. memory" /></label>
      <label>Setup<select id="setup-filter">
        <option value="all">Any setup</option>
        <option value="Desktop installer">Desktop installer</option>
        <option value="Command line">Command line</option>
        <option value="Docker">Docker</option>
      </select></label>
      <label>Model<select id="model-filter"><option value="all">Any model option</option><option value="local">Can run a model locally</option></select></label>
      <label>Sort by<select id="v2-sort"><option value="stars">Most stars</option><option value="name">Name A–Z</option><option value="recent">Recently added</option></select></label>
    </div>
    <details class="language-options"><summary>Filter by programming language</summary>
      <div class="chip-strip" id="v2-lang-filters" role="group" aria-label="Language">{['all', ...languages].map(lang =>
        <button class="chip" type="button" data-lang={lang} aria-pressed={lang === 'all' ? 'true' : 'false'}>
          <span class="check" aria-hidden="true">✓</span>{lang === 'all' ? 'All languages' : languageLabel[lang] ?? lang}
          <span class="chip-count">{lang === 'all' ? projects.length : projects.filter(p => p.language === lang).length}</span>
        </button>
      )}</div>
    </details>
    <p class="filter-help" id="filter-help" hidden>Setup and local-model filters show options documented in the profiles. An agent may support other setups.</p>
    <div class="list-context"><strong id="v2-results-count" aria-live="polite">{directory.length} projects</strong>
      <span>Each line shows one agent’s daily star additions over the last 30 complete days.</span>
      <button id="clear-filters" type="button" hidden>Clear filters</button>
    </div>
    <div class="project-list" id="v2-project-list">
      {directory.map(p => {
        const historical = p.github_data?.availability === 'unavailable' || p.status === 'archived';
        const setup = setupsBySlug.get(p.slug);
        const tagline = p.tagline;
        return <a href={`/projects/${p.slug}/`} class="v2-row"
          data-language={p.language} data-name={p.name} data-stars={p.stars ?? 0} data-added={p.added}
          data-unavailable={String(historical)} data-uses={usesBySlug.get(p.slug)?.join(' ')}
          data-setup={setup?.setup ?? ''} data-cli={p.platform?.includes('cli') ? 'yes' : 'no'} data-local={setup?.localModel ? 'yes' : 'no'}
          data-search={[p.name, p.slug, p.description, p.tagline, languageLabel[p.language], setup?.setup, setup?.localModel, p.mcp_support ? 'MCP Model Context Protocol' : '', ...(p.platform ?? []), ...(p.category ?? [])].join(' ').toLowerCase()}>
          <span class="agent-name"><span aria-hidden="true">{p.emoji}</span><strong>{p.name}</strong></span>
          <span class="agent-note">{historical ? (p.github_data?.availability === 'unavailable' ? 'Unavailable · last checked ' : 'Archived · last checked ') + (p.github_data?.last_checked ?? p.github_data?.last_enriched)?.slice(0,10) : <><span class="sr-only">Project summary: </span>{tagline}</>}</span>
          <span class="language">{languageLabel[p.language] ?? p.language}{p.mcp_support && <abbr title="Model Context Protocol connects agents to other software">MCP</abbr>}</span>
          <span class="activity">{historical ? 'Historical record' : <MomentumSparkline project={p} asOf={generated} inline />}</span>
          <span class="stars" title={(p.stars ?? 0).toLocaleString('en-US') + ' GitHub stars'}>{formatStars(p.stars ?? 0)} <span aria-hidden="true">★</span><span class="sr-only"> stars</span></span>
        </a>;
      })}
    </div>
    <p id="directory-empty" hidden>No agents match those choices. Clear a filter or try a different search.</p>
  </section>

  <section class="wrap explore">
    <div class="section-head"><h2>Compare two agents</h2><a href="/compare/">Choose a pair →</a></div>
    <div class="pairs">{featuredPairs.map(pair => pair && <a href={`/compare/${pair.canonical}/`}>{projectMap.get(pair.slugA)?.name} vs {projectMap.get(pair.slugB)?.name} →</a>)}</div>
    <div class="links">
      <a href="/analysis/#after-the-spike"><strong>After the spike</strong><span>Which agents drew steady interest, and which saw a sudden rush?</span></a>
      <a href="/leaderboard/"><strong>Leaderboard</strong><span>Compare stars, recent activity and issue load.</span></a>
      <a href="/best-alternatives/"><strong>Alternatives to OpenClaw</strong><span>Pick a shortlist for the task you have in mind.</span></a>
    </div>
  </section>
</Layout>
<style>
  .wrap{width:100%;max-width:72rem;margin-inline:auto;padding-inline:1.25rem}
  .hero{padding-block:clamp(1rem,3vw,2.5rem) 2rem}
  .hero-top{display:grid;gap:1rem}
  .hero-copy{align-self:center}
  .hero h1{text-wrap:balance}
  .eyebrow,.hero-metrics,.place small,.browse-all small{font-family:theme('fontFamily.mono');font-variant-numeric:tabular-nums}
  .eyebrow{font-size:.71rem;font-weight:650;letter-spacing:.07em;text-transform:uppercase;color:#8f3922;margin-bottom:.6rem}
  .intro{font-size:1.07rem;line-height:1.5;color:theme('colors.ledger.muted');max-width:31rem;margin:.75rem 0}
  .hero-metrics{display:flex;gap:.15rem .65rem;align-items:baseline;flex-wrap:wrap;color:#655747;font-size:.75rem;line-height:1.5}
  .hero-metrics :global(.data-stamp){font-size:inherit}
  .hero-art{display:block;width:100%;height:auto;aspect-ratio:2/1;border-radius:.7rem;border:1px solid #e5d6b8}
  .chooser{margin-top:1.4rem}
  .chooser h2{margin-bottom:.75rem}
  .chooser-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:.65rem}
  .chooser-grid a{border:1px solid #d5c8b7;border-radius:.65rem;min-width:0;text-decoration:none}
  .place{display:grid;grid-template-rows:auto 1fr;gap:.6rem;background:#fffdfa;padding:.45rem}
  .place-art{display:grid;place-items:center;background:#f6e8cf;border-radius:.36rem;height:clamp(5rem,8vw,6.75rem);overflow:hidden}
  .place-art img{width:100%;height:100%;min-height:0;object-fit:cover}
  .place-copy{display:grid;align-content:start;padding:0 .25rem .25rem}
  .place strong,.browse-all strong{font:700 1rem/1.2 theme('fontFamily.display')}
  .place small,.browse-all small{font-size:.73rem;margin-top:.2rem;color:#655747}
  .browse-all{display:flex;flex-direction:column;justify-content:center;gap:.45rem;padding:1rem;color:#fffaf3;background:#342820}
  .browse-all small{color:#e4d3bc}.chooser-grid a:hover strong{text-decoration:underline;text-underline-offset:.16em}
  .chooser-grid a:hover{border-color:#9b7251}
  .section-head,.list-context,.chip-strip,.pairs,.links{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap}
  .section-head a,.pairs a{display:inline-flex;align-items:center;min-height:44px}
  .section-head a,.pairs a,.list-context button{color:theme('colors.ledger.text');text-decoration:underline;text-underline-offset:.22em}
  .section-head a:hover,.pairs a:hover,.links a:hover strong{text-decoration:underline}
  .stars,.language,.chip-count,.list-context strong{font-family:theme('fontFamily.mono');font-variant-numeric:tabular-nums}
  .directory{scroll-margin-top:5rem;padding-bottom:2.5rem}.section-head{justify-content:space-between;border-bottom:2px solid theme('colors.ledger.border');margin-bottom:1rem}

  .filters,.language-options{min-width:0}.filters legend,.search-controls label{font-size:.875rem;font-weight:600}
  .chip-strip{flex-wrap:nowrap;overflow:auto;padding:.4rem .25rem .5rem;gap:.375rem;scrollbar-width:thin}
  .chip-strip.more-right{mask-image:linear-gradient(to right,#000 calc(100% - 1.2rem),transparent)}
  .chip{border:1px solid theme('colors.ledger.border');background:theme('colors.ledger.surface');border-radius:2rem;flex:none;padding:.4rem .7rem;min-height:44px;font-size:.8125rem;color:theme('colors.ledger.muted')}
  .chip[aria-pressed=true]{border-color:theme('colors.ledger.text');color:theme('colors.ledger.text');background:theme('colors.ledger.hover');font-weight:650}
  .chip .check{display:none}.chip[aria-pressed=true] .check{display:inline;margin-right:.3rem}.chip-count{margin-left:.3rem}
  .search-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem;margin:.75rem 0}
  .search-controls label{display:flex;flex-direction:column;gap:.3rem;min-width:0}.search-controls input,.search-controls select{width:100%;min-width:0;min-height:44px;border-radius:.4rem;border:1px solid theme('colors.ledger.border');background:theme('colors.ledger.surface');color:theme('colors.ledger.text');padding:.4rem .6rem;font-weight:400}
  .language-options summary{width:fit-content;padding:.7rem 0;min-height:44px;cursor:pointer;font-size:.875rem;text-decoration:underline;text-underline-offset:.18em}
  .list-context,.filter-help{font-size:.8125rem;color:theme('colors.ledger.muted')}.list-context{gap:.35rem 1rem;margin:.6rem 0}.list-context button{min-height:44px}
  .project-list{background:theme('colors.ledger.surface');border:1px solid theme('colors.ledger.border');border-radius:.75rem;overflow:hidden}
  .v2-row{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-areas:"name stars" "note note" "lang activity";align-items:center;gap:.3rem .55rem;padding:.8rem;border-bottom:1px solid theme('colors.ledger.border')}
  .v2-row:last-child{border:none}.v2-row:hover{background:theme('colors.ledger.hover')}.v2-row:focus-visible{outline-offset:-3px}
  .agent-name{grid-area:name;display:flex;align-items:center;gap:.5rem;min-width:0;font-family:theme('fontFamily.display');font-size:1rem}
  .agent-name strong,.agent-note{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.agent-name strong{min-width:0}.agent-note{grid-area:note;color:theme('colors.ledger.muted');font-size:.8125rem}
  .language{grid-area:lang;display:flex;align-items:center;flex-wrap:wrap;gap:.3rem;color:theme('colors.ledger.muted');font-size:.8125rem}
  abbr{font-family:theme('fontFamily.body');font-size:.75rem}.activity{grid-area:activity;justify-self:end;font-size:.8125rem;color:theme('colors.ledger.muted')}.stars{grid-area:stars;text-align:right;white-space:nowrap;font-size:.875rem;font-weight:600}
  .v2-row[data-unavailable=true] .agent-note{font-weight:600}.v2-row[hidden]{display:none}
  #directory-empty{padding:1.25rem;background:theme('colors.ledger.surface');border-radius:.5rem}
  .explore{padding-bottom:3rem}.pairs{gap:.25rem 1.1rem}.links{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,13rem),1fr));margin-top:1rem}
  .links a{align-self:stretch;display:grid;align-content:start;gap:.3rem;padding:1rem;border:1px solid theme('colors.ledger.border');border-radius:.65rem;background:theme('colors.ledger.surface')}
  .links span{color:theme('colors.ledger.muted');font-size:.875rem}
  @media(min-width:640px){.wrap{padding-inline:2rem}.search-controls{grid-template-columns:2fr repeat(3,minmax(0,1fr))}.hero-top{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr);align-items:center;gap:2rem}}
  @media(min-width:860px){
    .v2-row{grid-template-areas:"name note lang activity stars";grid-template-columns:minmax(7.5rem,1.1fr) minmax(5rem,1.6fr) minmax(5.8rem,.75fr) minmax(11rem,auto) 4.7rem;gap:1rem;padding:1rem}
  }
  @media(max-width:639px){
    .hero-art{grid-row:1}
    .chooser{margin-top:1rem}
    .chooser-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:.45rem}
    .place{grid-template:1fr / 2.75rem minmax(0,1fr);align-items:center;gap:.45rem}
    .place-art{height:auto;aspect-ratio:3/2}.place-copy{padding:0}.place strong{font-size:.91rem}
    .browse-all{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center;min-height:44px;padding:.55rem .85rem}
    .browse-all small{margin:0}
  }
  @media(max-width:380px){.activity :global(svg){width:50px}}
</style>
<script>
  const search = document.querySelector<HTMLInputElement>('#v2-search')!;
  const setup = document.querySelector<HTMLSelectElement>('#setup-filter')!;
  const model = document.querySelector<HTMLSelectElement>('#model-filter')!;
  const sort = document.querySelector<HTMLSelectElement>('#v2-sort')!;
  const list = document.querySelector<HTMLElement>('#v2-project-list')!;
  const rows = Array.from(list.querySelectorAll<HTMLElement>('.v2-row'));
  const reset = document.querySelector<HTMLButtonElement>('#clear-filters')!;
  const count = document.querySelector('#v2-results-count')!;
  const uses = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-use]'));
  const langs = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-lang]'));
  let use = 'all', lang = 'all';
  // Encode reader choices so a filtered shortlist can be bookmarked or shared.
  function render(writeUrl = true) {
    const query = search.value.trim().toLowerCase();
    for (const button of uses) button.setAttribute('aria-pressed', String(button.dataset.use === use));
    for (const button of langs) button.setAttribute('aria-pressed', String(button.dataset.lang === lang));
    const filtered = query || lang !== 'all' || use !== 'all' || setup.value !== 'all' || model.value !== 'all';
    let visible = 0;
    for (const row of rows) {
      const data = row.dataset;
      const matchSetup = setup.value === 'all' || data.setup === setup.value || (setup.value === 'Command line' && data.cli === 'yes');
      row.hidden = !((data.search ?? '').includes(query) && (lang === 'all' || lang === data.language) &&
        (use === 'all' || (data.uses ?? '').split(' ').includes(use)) && matchSetup && (model.value === 'all' || data.local === 'yes'));
      if (!row.hidden) visible++;
    }
    count.textContent = visible + (visible === 1 ? ' project' : ' projects');
    reset.hidden = !filtered;
    document.querySelector<HTMLElement>('#directory-empty')!.hidden = visible !== 0;
    document.querySelector<HTMLElement>('#filter-help')!.hidden = setup.value === 'all' && model.value === 'all';
    if (writeUrl) {
      const url = new URL(location.href);
      for (const [key,value] of Object.entries({q:search.value.trim(),use,lang,setup:setup.value,model:model.value,sort:sort.value})) {
        if (value && value !== 'all' && !(key === 'sort' && value === 'stars')) url.searchParams.set(key,value);
        else url.searchParams.delete(key);
      }
      history.replaceState(null,'',url);
    }
  }
  function order() {
    const sorted = [...rows].sort((a,b) => {
      const unavailable = Number(a.dataset.unavailable === 'true') - Number(b.dataset.unavailable === 'true');
      if (unavailable) return unavailable;
      if (sort.value === 'recent') return b.dataset.added!.localeCompare(a.dataset.added!) || a.dataset.name!.localeCompare(b.dataset.name!);
      if (sort.value === 'stars' && a.dataset.stars !== b.dataset.stars) return Number(b.dataset.stars) - Number(a.dataset.stars);
      return a.dataset.name!.localeCompare(b.dataset.name!);
    });
    list.append(...sorted);
  }
  function restore() {
    const params = new URLSearchParams(location.search);
    search.value = params.get('q') || '';
    use = uses.find(b => b.dataset.use === params.get('use'))?.dataset.use || 'all';
    lang = langs.find(b => b.dataset.lang === params.get('lang'))?.dataset.lang || 'all';
    if (lang !== 'all') document.querySelector<HTMLDetailsElement>('.language-options')!.open = true;
    for (const [select,key] of [[setup,'setup'],[model,'model'],[sort,'sort']] as const) {
      const value = params.get(key);
      select.value = Array.from(select.options).some(o => o.value === value) ? value! : select.options[0].value;
    }
    order();render(false);
  }
  for (const button of uses) button.addEventListener('click', () => { use = button.dataset.use!; render(); });
  for (const button of langs) button.addEventListener('click', () => { lang = button.dataset.lang!; render(); });
  [setup,model].forEach(el => el.addEventListener('change', () => render()));
  sort.addEventListener('change', () => {order();render()});
  search.addEventListener('input', () => render());
  reset.addEventListener('click', () => {
    use = lang = setup.value = model.value = 'all'; search.value = ''; render();search.focus();
  });
  for (const strip of document.querySelectorAll<HTMLElement>('.chip-strip')) {
    const indicateOverflow = () => strip.classList.toggle('more-right',
      strip.clientWidth > 0 && strip.scrollWidth - strip.clientWidth - strip.scrollLeft > 2);
    strip.addEventListener('scroll', indicateOverflow, { passive: true });
    new ResizeObserver(indicateOverflow).observe(strip);
  }
  window.addEventListener('popstate', restore);
  restore();
</script>
