---
import Layout from '../layouts/Layout.astro';
import CopySnippet from '../components/CopySnippet.astro';
import {loadProjects} from '../lib/projects';
const projects=(await loadProjects()).filter(p=>p.github_data?.availability!=='unavailable').sort((a,b)=>a.name.localeCompare(b.name));
const snippet=(slug:string)=>`[![Listed on Shelldex](https://shelldex.com/badges/shelldex-badge.svg)](https://shelldex.com/projects/${slug}/)`;
---
<Layout title="README badges — Shelldex" description="Get the badge that links directly to your agent’s Shelldex profile." robots="noindex, follow">
<div class="max-w-[72rem] mx-auto px-5 sm:px-8 py-12"><section class="max-w-3xl">
<p class="font-mono text-sm text-ledger-red">FOR MAINTAINERS</p><h1 class="mt-4 mb-4">A badge for your README<span class="text-ledger-red">.</span></h1>
<p class="text-lg">Choose your agent and copy its Markdown into your README. The badge takes readers straight to its profile.</p>
<img src="/badges/shelldex-badge.svg" alt="Listed on Shelldex" class="h-5 my-6" />
<div id="badge-filter" hidden><label for="badge-name" class="block font-semibold">Find your agent</label><input type="search" id="badge-name" placeholder="Agent name" class="my-2 rounded-lg border border-ledger-border-strong p-3 w-full" /><p id="badge-count" role="status" class="text-sm text-ledger-muted"></p></div>
<div class="mt-5 space-y-2">{projects.map(p=><details data-project={p.name.toLowerCase()} class="rounded-lg bg-white border border-ledger-border px-5"><summary class="cursor-pointer py-3"><span aria-hidden="true">{p.emoji}</span> {p.name}</summary><CopySnippet value={snippet(p.slug)} label={p.name+' badge'} /></details>)}</div>
</section></div></Layout>
<script>
  const filter=document.querySelector<HTMLElement>('#badge-filter')!;
  filter.hidden=false;
  const field=document.querySelector<HTMLInputElement>('#badge-name')!;
  field.addEventListener('input',()=>{let n=0; const q=field.value.trim().toLowerCase(); for(const row of document.querySelectorAll<HTMLElement>('[data-project]')){row.hidden=!row.dataset.project!.includes(q); if(!row.hidden)n++;}document.querySelector('#badge-count')!.textContent=n ? n+' matches' : 'No matches. Try another name.';});
</script>
