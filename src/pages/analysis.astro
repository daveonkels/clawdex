---
import Layout from '../layouts/Layout.astro';
import AfterTheSpike from '../components/AfterTheSpike.astro';
import DataStamp from '../components/DataStamp.astro';
import { loadProjects } from '../lib/projects';
import { loadLeaderboard } from '../lib/compare';
import { buildEditorial } from '../lib/editorial';
import { languageLabel } from '../lib/constants';
import { editionRows } from '../lib/spike-edition';

const projects = await loadProjects();
const { entries, generated } = loadLeaderboard();
const editorial = buildEditorial(projects, entries, generated);
const rows = editionRows(projects);
const weekLeaders = [...rows].sort((a, b) => b.lastWeek - a.lastWeek || a.slug.localeCompare(b.slug));
const weeklyExamples = [...new Set([...weekLeaders.slice(0, 3), ...['atomic-agent','nullclaw','bashobot'].map(slug => rows.find(r => r.slug === slug)! )])];
const weeklyMax = weekLeaders[0].lastWeek;
const languages = new Map<string, number>();
for (const project of projects) languages.set(project.language, (languages.get(project.language) ?? 0) + 1);
const languageCounts = [...languages].sort((a,b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const fmt = (value: number) => value.toLocaleString('en-US');
const sections = [
  ['after-the-spike','After the spike'], ['executive-summary','Executive summary'], ['growth','The final week'],
  ['taxonomy','Agent categories'], ['choosing-an-agent','Choose a first trial'], ['security','Permissions'], ['languages','Languages'],
  ['comparative-metrics','Compare the numbers'], ['timeline','Sources and history']
];
const comparisons = [
  { need:'A note waiting in my chat before breakfast', test:'Ask each assistant to send a short briefing to your own chat in five minutes. Check where you can see a finished note if the message never arrives.', agents:'Hermes Agent and OpenClaw', href:'/compare/hermes-vs-openclaw/', source:'Hermes scheduling guide', url:'https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/features/cron.md' },
  { need:'Help with two files on my computer', test:'Give each assistant copies of two quotes. Can you pick the folder yourself, ask for a side-by-side comparison, and trace each price to a page?', agents:'AionUi and Atomic Agent', href:'/compare/?a=aionui&b=atomic-agent', source:'AionUi setup guide', url:'https://github.com/iOfficeAI/AionUi/wiki/Getting-Started' },
  { need:'A model I can run on my own machine', test:'Atomic Agent documents running downloadable model weights locally. Hermes also describes a local setup. Check your operating system and available memory before choosing a model. Compare the time to finish your usual task.', agents:'Atomic Agent and Hermes Agent', href:'/compare/?a=atomic-agent&b=hermes', source:'Atomic Agent’s setup and hardware guidance', url:'https://github.com/AtomicBot-ai/atomic-agent' },
];
const title = 'After the spike: OpenClaw ecosystem analysis | Shelldex';
const description = 'Which agents drew steady interest, and which saw a short burst? Explore daily GitHub star additions, then choose a first task for the agents you want to compare.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: 'https://shelldex.com/analysis/',
  publisher: { '@type': 'Organization', name: 'Shelldex', url: 'https://shelldex.com/' },
};
---
<Layout {title} {description} {jsonLd}>
  <div class="max-w-[72rem] mx-auto px-5 sm:px-8">
    <article class="report">
      <nav aria-label="On this page" class="contents">
        <details id="analysis-contents"><summary>On this page</summary>
          <div>{sections.map(([id,label]) => <a href={'#' + id}>{label}</a>)}</div>
        </details>
      </nav>
      <AfterTheSpike {rows} />
      <section id="executive-summary"><h2>Executive summary</h2>
        <p>Hermes Agent led the study with {fmt(rows[0].total)} additions in 30 days. The next two were {rows[1].name} ({fmt(rows[1].total)}) and {rows[2].name} ({fmt(rows[2].total)}). A spike can help you discover a project. To decide whether to keep it, try a task you can check yourself.</p>
        <p>For a daily briefing, start with <a href="/compare/hermes-vs-openclaw/">Hermes Agent and OpenClaw</a>. For an assistant in a group chat, compare <a href="/compare/astrbot-vs-openclaw/">AstrBot and OpenClaw</a> and check who can give it instructions.</p>
      </section>
      <section id="growth"><h2>Who was still gaining stars in the final week?</h2>
        <p>October 31 through November 6, 2026. Each bar adds up seven complete days of additions. The three leaders appear alongside Atomic Agent, NullClaw and BashoBot for a sense of the range.</p>
        <figure aria-label="Stars added in the final seven days"><ul class="bars">{weeklyExamples.map(row => <li>
          <b>{row.name}</b><span class="track" aria-hidden="true"><i class:list={{leader:row.lastWeek === weeklyMax}} style={{width:(100*row.lastWeek/weeklyMax)+'%'}} /></span>
          <span class="value">{fmt(row.lastWeek)}</span>
        </li>)}</ul><figcaption>Bars share a scale from zero to {fmt(weeklyMax)} stars. Zero means all seven days were reported and none had additions.</figcaption></figure>
        <details><summary>See all {rows.length} weekly totals</summary><ol class="totals">{weekLeaders.map(r => <li><span>{r.name}</span><b>{fmt(r.lastWeek)}</b></li>)}</ol></details>
        <p class="note">These additions count people who still starred the project on November 7. Net growth also counts people who removed their stars and needs two dated totals. <a href="/methodology/#star-history">How we measure star history</a></p>
      </section>
      <section id="taxonomy"><h2>Agent categories in practice</h2>
        <details><summary>Explore six examples by what you need to do</summary>
          <p>Selected in November 2026. These examples describe jobs highlighted in the projects’ own guides. An agent can suit more than one.</p>
          <dl class="categories">
            <dt>Work with files at your desk</dt><dd><a href="https://github.com/iOfficeAI/AionUi/wiki/Getting-Started">AionUi</a> lets you choose a working folder. Start with copies of two documents.</dd>
            <dt>Reach a shared chat</dt><dd><a href="https://github.com/AstrBotDevs/AstrBot">AstrBot</a> connects to messaging services. Look up the service your group already uses.</dd>
            <dt>Keep a preference for later</dt><dd><a href="https://github.com/NousResearch/hermes-agent">Hermes Agent</a> describes memory and reusable skills. Ask it to remember a harmless preference, then try a fresh conversation.</dd>
            <dt>Choose which services tools can reach</dt><dd><a href="https://github.com/nearai/ironclaw#security">IronClaw</a> documents permissions for individual tools. Read which ones your intended job needs.</dd>
            <dt>Use a model on your own computer</dt><dd><a href="https://github.com/AtomicBot-ai/atomic-agent">Atomic Agent</a> supports downloadable models. Check the model’s memory requirements against your computer.</dd>
            <dt>Build with a tiny device</dt><dd><a href="https://github.com/memovai/mimiclaw">MimiClaw</a> targets an ESP32 board. Check the supported hardware and what still needs an internet connection before buying parts.</dd>
          </dl>
        </details></section>
      <section id="choosing-an-agent"><h2>Choose a first trial</h2>
        <p>These examples were reviewed on November 7, 2026. Pick the job closest to yours and give both agents the same files, deadline and instructions.</p>
        <div class="choices">{comparisons.map(item => <div><h3>{item.need}</h3><p>{item.test}</p>
          <p><a href={item.href}>Compare {item.agents}</a> · <a href={item.url}>{item.source}</a></p>
        </div>)}</div>
      </section>
      <section id="security"><h2>Check what the assistant can touch</h2>
        <p>If all you want is a draft reply, start with a copy of the message in a separate folder and leave the mailbox disconnected. Then ask which permissions you would have to grant for the assistant to send it.</p>
        <p>IronClaw describes explicit permissions for tools to contact approved web addresses or use credentials. OpenClaw documents how to limit the files and tools an assistant can reach. For either agent, check which settings apply to your installation before giving it real accounts. These are the projects’ documented designs. Shelldex has not audited their enforcement.</p>
        <p><a href="https://github.com/nearai/ironclaw#security">IronClaw’s security model</a> · <a href="https://docs.openclaw.ai/gateway/security">OpenClaw’s security guide</a> · <a href="/faq/#security">Privacy and control for your first agent</a></p>
      </section>
      <section id="languages"><h2>Which languages are represented?</h2>
        <p>Language matters most if you plan to change the code. For everyday use, check that the agent supports your device and the apps you need.</p>
        <figure aria-label="Directory entries by primary programming language"><ul class="bars">{languageCounts.map(([lang,count],index) => <li>
          <b>{languageLabel[lang] ?? lang}</b><span class="track" aria-hidden="true"><i class:list={{leader:index===0}} style={{width:(100*count/languageCounts[0][1])+'%'}} /></span><span class="value">{count} {count === 1 ? 'agent' : 'agents'}</span>
        </li>)}</ul><figcaption>One primary language per directory entry. Bar lengths are proportional to the number of agents.</figcaption></figure>
      </section>
      <section id="comparative-metrics"><h2>Compare the numbers</h2>
        <p>The current directory covers {projects.length} agents. This edition used the {rows.length} with complete daily history in its November 7 dataset. The leaderboard records the latest published check.</p>
        <DataStamp date={generated}><span data-editorial="snapshotNotice">{editorial.snapshotNotice}</span></DataStamp>
        <p><a href="/leaderboard/">Sort the full leaderboard</a> · <a href="/methodology/#health-score">What the maintenance score measures</a></p>
      </section>
      <section id="timeline"><h2>Sources and project history</h2>
        <details><summary>Read the sources behind this edition</summary><ul class="sources">
          <li><a href="/analysis/data/daily-stars-2026-11-07.csv">Daily observations for the 50 repositories (CSV)</a> · October 8 to November 6, 2026.</li>
          <li><a href="/analysis/data/three-day-share.svg">Download the three-day comparison figure (SVG)</a>.</li>
          <li><a href="/about/#timeline">OpenClaw’s naming and stewardship timeline</a>, with links to the project and its founder.</li>
          <li><a href="/methodology/#corrections">Send a correction</a> with the source and date.</li>
        </ul></details>
      </section>
      <section id="conclusions"><h2>Try the job you actually need</h2><p>Use two copies of the same sample files. Which agent can complete your task, show where its answer came from, and let you stop before it makes a change? <a href="/faq/#compare-trial">Use the field guide’s comparison checklist.</a></p></section>
    </article>
  </div>
</Layout>
<style>
  .report{max-width:48rem;padding:1.5rem 0 3rem;color:#342b24}.report>section{margin:3rem 0}
  .report :global(section[id]),.anchor{scroll-margin-top:8rem}
  h2,h3{color:#1c1410}
  h2{margin:0 0 .8rem}
  p{line-height:1.65;margin:.65rem 0;max-width:74ch}a{color:#342b24;text-decoration:underline;text-underline-offset:.18em}a:hover{color:#a93019}
  .contents{position:sticky;z-index:30;top:3.5rem;background:#f8f4ed;border-block:1px solid #d5cabd;margin:0 0 2rem}
  .contents details>div{position:absolute;inset:100% 0 auto;background:#f8f4ed;border:1px solid #d5cabd;box-shadow:0 7px 18px #36271422;display:grid;grid-template-columns:repeat(2,1fr);padding:.5rem;max-height:55vh;overflow:auto}
  .contents a{padding:.7rem;font-size:.88rem}.anchor{display:block}summary{cursor:pointer;padding:.72rem .25rem;font-weight:650}
  figure,.choices>div{border:1px solid #ddd4c8;background:#fffdf8;padding:clamp(.8rem,2vw,1.3rem);border-radius:.75rem;margin:1rem 0}
  .categories dt{font-weight:700;margin-top:1rem}.categories dd{line-height:1.6}.choices>div p:last-child{font-size:.88rem;margin-bottom:0}.bars{margin:0;padding:0}.bars li{display:grid;grid-template-columns:minmax(6.3rem,1fr) minmax(3rem,2fr) 5.1rem;align-items:center;gap:.65rem;padding:.4rem 0}
  .bars b{font-size:.9rem}.value,.totals b{text-align:right;font:500 .85rem/1.45 monospace;white-space:nowrap;font-variant-numeric:tabular-nums}
  .track{height:.5rem;background:#e9e1d7;border-radius:.5rem}.track i{display:block;background:#8b7e71;border-radius:inherit;height:100%}.track .leader{background:#bd3820}
  figcaption,.note{color:#5f5449;font-size:.85rem;line-height:1.55;margin-top:1rem}.totals{columns:2;column-gap:2rem}.totals li{display:flex;justify-content:space-between;border-bottom:1px solid #ddd4c8;padding:.4rem 0;break-inside:avoid}.sources li{margin:.6rem 0}
  @media(min-width:640px){.contents{top:4rem}.contents details>div{grid-template-columns:repeat(3,1fr)}}@media(max-width:440px){.totals{columns:1}.bars li{gap:.35rem}}
</style>
<script>
  const contents = document.querySelector<HTMLDetailsElement>('#analysis-contents');
  contents?.addEventListener('click', e => {
    if (e.target instanceof Element && e.target.closest('a')) contents.open = false;
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && contents?.open) {
      contents.open = false;
      contents.querySelector('summary')?.focus();
    }
  });
</script>
