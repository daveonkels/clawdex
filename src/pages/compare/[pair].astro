---
import Layout from '../../layouts/Layout.astro';
import DataStamp from '../../components/DataStamp.astro';
import MomentumSparkline from '../../components/MomentumSparkline.astro';
import { loadProjects } from '../../lib/projects';
import type { Project } from '../../lib/projects';
import { comparisonHighlights, comparisonRows, generateFAQItems, generateRecommendation, getIndexableComparePairs, getRelatedComparisons, loadLeaderboard } from '../../lib/compare';
import { choiceNote, quickStartUrl } from '../../lib/agent-choice';

export async function getStaticPaths() {
  const projects = await loadProjects();
  const pairs = getIndexableComparePairs(projects);
  const bySlug = new Map(projects.map(p => [p.slug,p]));
  return pairs.map(pair => ({
    params: { pair: pair.canonical },
    props: { a: bySlug.get(pair.slugA)!, b: bySlug.get(pair.slugB)!,
      related: getRelatedComparisons(pair.slugA, pair.slugB, pairs, 6).map(p => ({url: '/compare/'+p.canonical+'/', title: bySlug.get(p.slugA)!.name+' vs '+bySlug.get(p.slugB)!.name})) }
  }));
}
interface Props { a: Project; b: Project; related: {url: string; title: string}[] }
const { a, b, related } = Astro.props;
const { entries, generated } = loadLeaderboard();
const lookup = (p: Project) => entries.find(e => e.slug === p.slug) ?? null;
const rows = comparisonRows(a, b, lookup(a), lookup(b));
const highlights = comparisonHighlights(rows);
const summary = generateRecommendation(a,b);
const faqs = generateFAQItems(a,b);
const title = `${a.name} vs ${b.name}`;
const base = `https://shelldex.com/compare/${Astro.params.pair}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  name: title,
  description: summary,
  url: base,
  about: [a, b].map(p => ({
    '@type': 'SoftwareApplication', name: p.name, url: `https://shelldex.com/projects/${p.slug}/`,
  })),
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Compare', item: 'https://shelldex.com/compare/' },
      { '@type': 'ListItem', position: 2, name: title, item: base },
    ],
  },
  mainEntity: faqs.map(q => ({
    '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: q.answer },
  })),
};
---
<Layout title={title+' | Shelldex'} description={summary} canonicalUrl={base}
  markdownUrl={base.replace('/compare/','/md/compare/').replace(/\/$/,'.md')}
  jsonUrl={base.replace('/compare/','/api/compare/').replace(/\/$/,'.json')}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="max-w-[72rem] mx-auto px-5 sm:px-8 py-8 sm:py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-ledger-muted mb-5"><a href="/compare/" class="underline">Compare</a> / {title}</nav>
    <h1 class="mb-3">{title}</h1>
    <DataStamp date={generated} />
    <p class="text-ledger-muted max-w-3xl mt-3">{summary}</p>
    {highlights.length > 0 && <section aria-label="Differences at a glance" class="grid sm:grid-cols-3 gap-2 mt-6 mb-5">
      {highlights.map(row => <div class="bg-ledger-surface border border-ledger-border rounded-xl py-3 px-4">
        <h2 data-heading="label">{row.label}</h2>
        <p class="text-xl font-mono font-semibold">{row.values[0]} <span class="text-sm text-ledger-muted">vs</span> {row.values[1]}</p>
        <p class="text-sm text-ledger-muted">{row.difference}</p>
      </div>)}
    </section>}
    <div class="grid sm:grid-cols-2 gap-3 mb-8">{[a,b].map(p => <section class="rounded-xl border border-ledger-border bg-ledger-surface p-4">
      <h2 data-heading="card">{choiceNote(p) ? 'Choose '+p.name+' if…' : 'What '+p.name+' does'}</h2>
      <p class="text-ledger-muted my-1">{choiceNote(p) ?? p.description}</p>
      <a class="underline text-sm" href={'/projects/'+p.slug+'/'}>{p.name} profile</a>
      {quickStartUrl(p) && <a class="underline text-sm ml-4" href={quickStartUrl(p)!}>Setup guide ↗</a>}
    </section>)}</div>
    <section aria-labelledby="compare-metrics">
      <h2 id="compare-metrics" class="mb-3">Side by side</h2>
      <div class="max-w-full overflow-x-auto rounded-xl border border-ledger-border bg-ledger-surface" tabindex="0" role="region" aria-label="Side-by-side metrics">
        <table class="w-full text-left text-sm">
          <thead><tr><th scope="col">Measure</th><th scope="col">{a.name}</th><th scope="col">{b.name}</th></tr></thead>
          <tbody>{rows.map(r=><tr><th scope="row">{r.label}<small>{r.detail}</small>{r.difference && <small class="direction">{r.difference}</small>}</th>{r.values.map(v=><td>{v}</td>)}</tr>)}</tbody>
        </table>
      </div>
      <p class="text-sm text-ledger-muted mt-2"><a href="/methodology/" class="underline">How Shelldex measures repository activity</a>. A dash means no figure was available.</p>
    </section>
    <section class="my-8"><h2 class="mb-3">When did people add stars?</h2>
      <div class="grid sm:grid-cols-2 gap-4">{[a,b].map(p=><div class="rounded-xl border border-ledger-border p-4 bg-ledger-surface"><h3>{p.name}</h3><MomentumSparkline project={p} averageGrowth7d={0} label="Daily star additions" /></div>)}</div>
    </section>
    <section class="my-8"><h2 class="mb-3">Trying these agents</h2>
      {faqs.map(q=><details class="border-b border-ledger-border py-2"><summary class="cursor-pointer font-semibold">{q.question}</summary><p class="my-2 text-ledger-muted">{q.answer}</p></details>)}
    </section>
    {related.length > 0 && <nav aria-label="Related comparisons"><h2 class="mb-2">Related comparisons</h2><div class="flex flex-wrap gap-4">{related.map(r=><a class="underline" href={r.url}>{r.title}</a>)}</div></nav>}
  </article>
</Layout>
<style>
th,td{padding:.7rem;border-bottom:1px solid #dfd7cb;vertical-align:top}
th[scope=row]{width:38%}thead{background:#f7f3ec}small{display:block;font-weight:400;color:#6b5c4f}td{font-variant-numeric:tabular-nums}.direction{font-weight:600;color:#1c1410}
@media(max-width:600px){th,td{padding:.45rem}th[scope=row]{width:36%}}
</style>
