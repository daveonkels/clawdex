---
import Layout from '../layouts/Layout.astro';
import { loadProjects, formatStars } from '../lib/projects';
import { loadLeaderboard, makeCanonicalSlug, getIndexableComparePairs } from '../lib/compare';
import { invoiceComparison } from '../lib/alternatives-art';
import TrialIllustration from '../components/TrialIllustration.astro';
import WorkflowIcon from '../components/WorkflowIcon.astro';
import DataStamp from '../components/DataStamp.astro';
import { archiveNotice, modelAccess, quickStartUrl, verifiedSetup } from '../lib/agent-choice';
import { buildEditorial } from '../lib/editorial';

const projects = await loadProjects();
const { entries: leaderboard, generated } = loadLeaderboard();
const editorial = buildEditorial(projects, leaderboard, generated);

// All alternatives (exclude openclaw), sorted by stars
const alternatives = projects
  .filter(p => p.slug !== 'openclaw' && !archiveNotice(p))
  .sort((a, b) => (b.stars ?? 0) - (a.stars ?? 0));

const historical = projects.filter(p => p.slug !== 'openclaw' && archiveNotice(p));
const pageTitle = 'OpenClaw alternatives by use case and GitHub stars | Shelldex';
const pageDescription = 'Find an agent for your phone, desktop files, chat or an always-on computer. Compare available OpenClaw alternatives and what you need to try them.';
const pairSlugs = new Set(getIndexableComparePairs(projects).map(p=>p.canonical));
const picks = ([
  ['aionui', 'files', 'Working with files', 'Choose a folder of sample files and ask for a summary you can check.'],
  ['hermes', 'clock', 'A recurring briefing', 'Schedule a task and send its result to your own chat. The host needs to be awake.'],
  ['kai', 'phone', 'An assistant on your phone', 'Use the mobile app when a phone is the device you have with you.'],
  ['atomic-agent', 'chip', 'Using your own model', 'Run a model on your computer and try a task with copies of your files. Check hardware requirements first.'],
] as const).filter(([slug])=>alternatives.some(p=>p.slug === slug));
function compareHref(slug: string) {
  const pair = makeCanonicalSlug('openclaw',slug);
  return pairSlugs.has(pair) ? '/compare/'+pair+'/' : '/compare/?a=openclaw&b='+slug;
}
const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": 'OpenClaw alternatives by GitHub stars',
  "description": pageDescription,
  "url": "https://shelldex.com/best-alternatives/",
  "numberOfItems": alternatives.length,
  "itemListElement": alternatives.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": p.name,
    "url": `https://shelldex.com/projects/${p.slug}/`,
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Shelldex", "item": "https://shelldex.com" },
    { "@type": "ListItem", "position": 2, "name": "OpenClaw alternatives", "item": "https://shelldex.com/best-alternatives/" },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} ogImage={new URL(invoiceComparison.src, 'https://shelldex.com').href} ogImageWidth={840} ogImageHeight={560} ogImageAlt={invoiceComparison.alt}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-[72rem] mx-auto px-5 sm:px-8 py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-ledger-muted mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ledger-red transition-colors">Shelldex</a>
      <svg class="w-4 h-4 opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      <span class="text-ledger-faint">OpenClaw alternatives</span>
    </nav>

    <header class="alt-intro"><div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold mb-4">OpenClaw alternatives</h1>
      <p class="text-lg text-ledger-muted max-w-3xl">Start with the job you have in mind. Then explore {alternatives.length} available alternatives in order of GitHub stars, a measure of how many people bookmarked the repository.</p>
      <nav aria-label="Explore OpenClaw alternatives" class="intro-actions"><a class="sd-primary" href="#workflows">Find an agent by task</a><a href="#rankings">Browse the rankings</a></nav>
      <DataStamp date={generated}>{editorial.snapshotNotice}</DataStamp></div>
      <TrialIllustration art={invoiceComparison} />
    </header>
    <section id="workflows" class="mb-10 scroll-mt-20">
      <h2 class="font-display text-2xl font-semibold mb-4">What would you like to do?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">{picks.map(([slug,icon,title,reason])=><article class="workflow p-5 rounded-xl border border-ledger-border bg-ledger-surface">
        <WorkflowIcon kind={icon} />
        <h3 class="font-semibold">{title}</h3><p class="text-ledger-muted my-2">{reason}</p>
        <a class="underline" href={'#'+slug}>Explore {projects.find(p=>p.slug===slug)?.name} ↓</a>
      </article>)}</div>
    </section>
    <h2 id="rankings" class="font-display text-2xl font-semibold mb-3 scroll-mt-20">Browse by GitHub stars</h2>
    <ol class="rankings">{alternatives.map((p,i)=><li class="rank-row rounded-xl bg-ledger-surface border border-ledger-border p-5 scroll-mt-20" id={p.slug}>
      <div class="rank-title"><h3 class="font-display text-xl font-bold"><span class="font-mono text-ledger-muted text-sm mr-2">{i+1}.</span><a href={'/projects/'+p.slug+'/'}>{p.name}</a></h3><span class="text-sm font-mono">{formatStars(p.stars ?? 0)} stars</span></div><div class="rank-summary">
      <p class="text-ledger-muted mt-2">{p.tagline}</p>
      {(verifiedSetup(p).devices || verifiedSetup(p).localModel) && <p class="text-sm mt-2">{[verifiedSetup(p).devices, verifiedSetup(p).localModel && modelAccess(p)].filter(Boolean).join(' · ')}</p>}
      </div><div class="row-actions text-sm"><a class="underline" href={'/projects/'+p.slug+'/'}>Profile</a><a class="underline" href={compareHref(p.slug)}>Compare with OpenClaw</a>{quickStartUrl(p) && <a class="underline" href={quickStartUrl(p)!}>Project guide ↗</a>}</div>
    </li>)}</ol>
    {historical.length>0 && <section class="mt-8"><h2 class="font-display text-xl font-semibold">Historical listings</h2>{historical.map(p=><p id={p.slug} class="my-2"><a class="underline" href={'/projects/'+p.slug+'/'}>{p.name}</a> · {archiveNotice(p)}</p>)}</section>}
    <!-- Bottom CTA -->
    <div class="mt-12 rounded-xl bg-ledger-red/5 border border-ledger-red/15 p-6 text-center">
      <p class="text-ledger-red font-medium mb-3">Know a project we are missing?</p>
      <a
        href="/submit/"
        class="sd-secondary"
      >
        Submit a Project
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Back links -->
    <div class="border-t border-ledger-border pt-8 mt-10 flex flex-wrap gap-6">
      <a href="/" class="inline-flex items-center gap-2 text-sm text-ledger-faint hover:text-ledger-red transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Directory
      </a>
      <a href="/compare/" class="inline-flex items-center gap-2 text-sm text-ledger-faint hover:text-ledger-red transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        Compare projects
      </a>
      <a href="/leaderboard/" class="inline-flex items-center gap-2 text-sm text-ledger-faint hover:text-ledger-red transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
        Leaderboard
      </a>
    </div>
  </div>
</Layout>
<style>
.alt-intro{display:grid;align-items:center;grid-template-columns:minmax(0,1.55fr) minmax(16rem,1fr);gap:clamp(1rem,4vw,4rem);margin:0 0 3rem}
.intro-actions,.row-actions{display:flex;align-items:center;flex-wrap:wrap;gap:.5rem 1rem}.intro-actions{margin:1rem 0 1.4rem}.intro-actions a:not(.sd-primary),.row-actions a,.workflow a{text-decoration:underline;text-underline-offset:.2em;color:#402e22;display:inline-flex;align-items:center;min-height:44px}

.workflow{display:flex;flex-direction:column;align-items:flex-start}.workflow h3{font:700 1.1rem/1.24 'Space Grotesk',sans-serif;margin-top:.65rem}.workflow p{line-height:1.5}.workflow a{margin-top:auto}
.rankings{display:grid;gap:.6rem}.rank-row{display:grid;grid-template-columns:minmax(10rem,.8fr) minmax(13rem,1.65fr) minmax(13rem,1fr);gap:1.2rem;align-items:center}
.rank-title{display:grid;gap:.3rem}.rank-summary p:first-child{margin:0}.row-actions{gap:.2rem 1rem}.row-actions a{min-height:34px}
@media(max-width:780px){.alt-intro{grid-template-columns:1fr}.rank-row{grid-template-columns:1fr;gap:.55rem}.rank-title{display:flex;align-items:baseline;justify-content:space-between;gap:.8rem}.row-actions a{min-height:44px}}
@media(max-width:430px){.rank-row{padding:1rem}}
</style>
