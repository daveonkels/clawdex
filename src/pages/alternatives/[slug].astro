---
import Layout from '../../layouts/Layout.astro';
import { loadProjects, formatStars } from '../../lib/projects';
import TrialIllustration from '../../components/TrialIllustration.astro';
import DataStamp from '../../components/DataStamp.astro';
import { archiveNotice, sharedTraits } from '../../lib/agent-choice';
import { loadLeaderboard } from '../../lib/compare';
import { buildComparisonHref, getIndexableCompareSlugSet } from '../../lib/compare-seo.js';
import { languageLabel } from '../../lib/constants';
import { INDEXABLE_ALTERNATIVE_SLUGS } from '../../lib/seo-sets.js';
import type { Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await loadProjects();
  return projects
    .filter(project => INDEXABLE_ALTERNATIVE_SLUGS.has(project.slug))
    .map(project => ({
      params: { slug: project.slug },
      props: { project, allProjects: projects },
    }));
}

interface Props {
  project: Project;
  allProjects: Project[];
}

const { project, allProjects } = Astro.props;
const { name, slug } = project;
const year = new Date().getFullYear();
const { generated } = loadLeaderboard();

// Share matching criteria with the related projects on each profile.
const alternatives = allProjects
  .filter(p => p.slug !== slug && !archiveNotice(p))
  .map(p => ({
    project: p,
    shared: sharedTraits(project, p),
  }))
  .sort((a, b) => b.shared.length - a.shared.length || (b.project.stars ?? 0) - (a.project.stars ?? 0));

const topAlternatives = alternatives.filter(a => a.shared.length > 0);
const otherProjects = alternatives.filter(a => a.shared.length === 0);
const indexableCompareSlugs = getIndexableCompareSlugSet(allProjects);

const pageTitle = `${name} Alternatives: ${alternatives.length} AI Agents Compared (${year}) | Shelldex`;
const pageDescription = `Looking for alternatives to ${name}? Compare ${alternatives.length} other AI agent projects by supported platforms and uses.`;

// FAQ schema
const topNames = topAlternatives.slice(0, 5).map(a => a.project.name);
const faqItems = [
  {
    question: `Which agents have something in common with ${name}?`,
    answer: topNames.length
      ? `${topNames.join(', ')} share a platform or use listed for ${name}. Each card shows the overlap. Projects with more matches appear first, with GitHub stars breaking ties.`
      : `We have yet to document another agent with the same platforms or uses as ${name}. The other profiles can help you explore different approaches.`,
  },
  {
    question: 'How can I narrow this list?',
    answer: 'Start with where you want to use the assistant. For a reminder from a phone, check that it works with your messaging app and that its host can stay on. For help with files, check which folders the assistant can access and whether it asks before writing changes.',
  },
  {
    question: `How can I try an alternative to ${name}?`,
    answer: 'Each available agent’s profile links to its setup guide and suggests a first task. Try the same task with sample information in both agents and compare the result before connecting a personal account.',
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer },
  })),
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Shelldex", "item": "https://shelldex.com" },
    { "@type": "ListItem", "position": 2, "name": name, "item": `https://shelldex.com/projects/${slug}/` },
    { "@type": "ListItem", "position": 3, "name": "Alternatives", "item": `https://shelldex.com/alternatives/${slug}/` },
  ],
};
---

<Layout title={pageTitle} description={pageDescription} robots="index, follow" canonicalUrl={`https://shelldex.com/alternatives/${slug}/`}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <div class="max-w-[72rem] mx-auto px-5 sm:px-8 py-12">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-ledger-muted mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ledger-red transition-colors">Shelldex</a>
      <svg class="w-4 h-4 opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      <a href={`/projects/${slug}/`} class="hover:text-ledger-red transition-colors">{name}</a>
      <svg class="w-4 h-4 opacity-40" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      <span class="text-ledger-muted">Alternatives</span>
    </nav>

    <!-- Header -->
    <header class="alt-intro"><div>
      <h1 class="font-display text-3xl sm:text-4xl font-bold text-ledger-text leading-tight mb-4">
        Alternatives to {name}
      </h1>
      <p class="text-lg text-ledger-muted leading-relaxed max-w-3xl">
        {alternatives.length} other agents are available in the directory. {topAlternatives.length} share a platform or use with <a href={`/projects/${slug}/`} class="text-ledger-red hover:text-ledger-coral transition-colors">{name}</a>. Agents with more matches come first. GitHub stars break ties.
      </p>
      <nav aria-label="Choose an alternative" class="intro-actions">
        <a class="sd-primary" href={topAlternatives.length ? '#matches' : '#other-projects'}>{topAlternatives.length ? 'Browse matching agents' : 'Browse other agents'}</a>
        <a href={'/compare/?a=' + slug}>Choose a pair to compare</a>
      </nav><DataStamp date={generated} /></div>
      <div><TrialIllustration compact />
        {project.first_task && <details class="sample-task"><summary>Try a sample task from {name}</summary><p>{project.first_task}</p></details>}
      </div>
    </header>

    <!-- Most Similar -->
    {topAlternatives.length > 0 && (
      <section id="matches" class="mb-12 scroll-mt-20">
        <h2 class="font-display text-2xl font-bold text-ledger-text mb-6">Agents with shared platforms or uses</h2>
        <div class="grid gap-4 lg:grid-cols-2">
          {topAlternatives.map(({ project: p, shared }) => {
            const pLangName = languageLabel[p.language] ?? p.language;


            return (
              <article class="rounded-xl border border-ledger-border bg-ledger-surface p-5 hover:border-ledger-red/20 transition-all">
                <div class="flex items-start gap-4">
                  <span aria-hidden="true" class="text-2xl leading-none mt-0.5 flex-shrink-0">{p.emoji}</span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline gap-3 mb-1 flex-wrap">
                      <a href={`/projects/${p.slug}/`} class="font-display text-lg font-bold text-ledger-text hover:text-ledger-red transition-colors">{p.name}</a>
                      {p.stars && p.stars > 0 && (
                        <span class="text-ledger-muted text-sm font-mono">{formatStars(p.stars)} stars</span>
                      )}
                      <span class="text-xs px-1.5 py-0.5 rounded border border-ledger-border text-ledger-muted">{pLangName}</span>

                    </div>
                    <p class="text-sm text-ledger-muted mb-1">{p.tagline}</p>
                    <p class="text-sm text-ledger-muted mb-3">Both list {shared.join(', ')}.</p>
                    <div class="match-actions flex flex-wrap gap-x-4">
                      <a href={buildComparisonHref(slug, p.slug, indexableCompareSlugs)} class="inline-flex items-center gap-1.5 text-xs text-ledger-muted hover:text-ledger-red transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                        Compare with {name}
                      </a>
                      <a href={`/projects/${p.slug}/`} class="inline-flex items-center gap-1.5 text-xs text-ledger-muted hover:text-ledger-red transition-colors">
                        Full profile
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                      </a>
                      <a href={INDEXABLE_ALTERNATIVE_SLUGS.has(p.slug) ? `/alternatives/${p.slug}/` : '/best-alternatives/'} class="inline-flex items-center gap-1.5 text-xs text-ledger-muted hover:text-ledger-red transition-colors">
                        {p.name} alternatives
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                      </a>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- Other Projects -->
    {otherProjects.length > 0 && (
      <section id="other-projects" class="mb-12 scroll-mt-20">
        <h2 class="font-display text-2xl font-bold text-ledger-text mb-6">Other Projects in the Ecosystem</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {otherProjects.map(({ project: p }) => {
            return (
              <a
                href={`/projects/${p.slug}/`}
                class="flex items-center gap-3 rounded-lg border border-ledger-border bg-ledger-surface/80 px-4 py-3 hover:border-ledger-red/20 transition-all group"
              >
                <span aria-hidden="true" class="text-xl flex-shrink-0">{p.emoji}</span>
                <div class="min-w-0 flex-1">
                  <p class="text-ledger-text text-sm font-medium group-hover:text-ledger-red transition-colors truncate">{p.name}</p>
                  <p class="text-xs text-ledger-muted truncate">{p.tagline}</p>
                </div>
                {p.stars && p.stars > 0 && (
                  <span class="text-xs text-ledger-muted font-mono flex-shrink-0">{formatStars(p.stars)}</span>
                )}
              </a>
            );
          })}
        </div>
        <a href={`/compare/?a=${slug}`} class="inline-flex items-center gap-2 text-sm text-ledger-muted hover:text-ledger-red transition-colors mt-4">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
          Compare {name} with any project in the compare tool
        </a>
      </section>
    )}

    <!-- FAQ -->
    <section class="mb-12">
      <h2 class="font-display text-2xl font-bold text-ledger-text mb-6">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {faqItems.map(item => (
          <details class="group rounded-xl border border-ledger-border bg-ledger-surface">
            <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-ledger-text font-medium text-sm hover:text-ledger-red transition-colors">
              <span>{item.question}</span>
              <svg class="w-4 h-4 text-ledger-muted group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-4 text-sm text-ledger-muted leading-relaxed border-t border-ledger-border pt-3">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Back links -->
    <div class="border-t border-ledger-border pt-8 flex flex-wrap gap-6">
      <a href={`/projects/${slug}/`} class="inline-flex items-center gap-2 text-sm text-ledger-muted hover:text-ledger-red transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/></svg>
        {name} profile
      </a>
      <a href="/best-alternatives/" class="inline-flex items-center gap-2 text-sm text-ledger-muted hover:text-ledger-red transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/></svg>
        All OpenClaw alternatives
      </a>
      <a href="/compare/" class="inline-flex items-center gap-2 text-sm text-ledger-muted hover:text-ledger-red transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
        Compare projects
      </a>
      <a href="/" class="inline-flex items-center gap-2 text-sm text-ledger-muted hover:text-ledger-red transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Directory
      </a>
    </div>
  </div>
</Layout>
<style>
.alt-intro{display:grid;align-items:center;grid-template-columns:minmax(0,1.6fr) minmax(16rem,1fr);gap:clamp(1rem,4vw,4rem);margin:0 0 3rem}
.intro-actions{display:flex;align-items:center;flex-wrap:wrap;gap:.4rem 1rem;margin:1rem 0}.intro-actions a:not(.sd-primary),.match-actions a{display:inline-flex;align-items:center;min-height:44px;text-decoration:underline;text-underline-offset:.2em;color:#402e22}

.sample-task summary{cursor:pointer;font-size:.9rem;font-weight:650;padding:.75rem 0}.sample-task p{font-size:.88rem;line-height:1.55;margin:.2rem 0 1rem;color:#614d3e}
@media(max-width:780px){.alt-intro{grid-template-columns:1fr}}
</style>
