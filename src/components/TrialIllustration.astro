---
import type { Illustration } from '../lib/alternatives-art';
interface Props { art: Illustration; compact?: boolean }
const { art, compact = false } = Astro.props;
---
<figure class:list={['trial-plate', { compact }]}>
  <img src={art.src} width="840" height="560"
    alt={art.alt} />
  <figcaption>{art.caption}</figcaption>
</figure>
<style>
  .trial-plate{margin:0;overflow:hidden;background:#fffaf0;border:1px solid #d6c5b4;border-radius:14px}
  img{display:block;width:100%;height:auto}
  figcaption{font-size:.85rem;line-height:1.5;color:#614d3e;text-align:center;max-width:42ch;margin:auto;padding:.65rem .95rem}
  .compact{max-width:26rem}
</style>
