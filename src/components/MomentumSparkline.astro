---
import { reportedDays } from '../lib/leaderboard-display';
import { formatStars } from '../lib/projects';

interface Props {
  project: any;
  averageGrowth7d?: number;
  compact?: boolean;
  inline?: boolean;
  label?: string;
  asOf?: string;
}
const { project, compact = false, inline = false, label = 'Star activity', asOf } = Astro.props;
const data = project.github_data;
const days = reportedDays(project, asOf ?? data?.last_enriched, compact ? 7 : 30);
const width = inline ? 84 : compact ? 88 : 136;
const height = inline ? 18 : compact ? 26 : 40;
const pad = inline ? 2 : compact ? 3 : 4;
const dayMs = 86_400_000;
const first = days[0];
const last = days.at(-1);
const peak = Math.max(0, ...days.map(day => day.stars));
const total = days.reduce((sum, day) => sum + day.stars, 0);
const span = first && last ? (Date.parse(last.date) - Date.parse(first.date)) / dayMs : 0;
const points = days.map(({ date, stars }) => ({
  date, stars,
  x: span ? pad + (Date.parse(date) - Date.parse(first.date)) / dayMs / span * (width - 2 * pad) : width / 2,
  y: height - pad - stars / Math.max(peak, 1) * (height - 2 * pad)
}));
const segments: (typeof points)[] = [];
for (const [i, point] of points.entries()) {
  if (i === 0 || Date.parse(point.date) - Date.parse(points[i - 1].date) !== dayMs) segments.push([]);
  segments[segments.length - 1].push(point);
}
const stroke = '#0a6b5a';
const noun = total === 1 ? 'star' : 'stars';
const caption = first && last ? `${project.name} daily GitHub stars, ${first.date} to ${last.date}. ${total.toLocaleString('en-US')} ${noun} still present from ${days.length} reported days. Peak: ${peak.toLocaleString('en-US')} in one day.` : 'Daily star history unavailable';
const growth = data?.star_growth_7d;
---
<div class={`flex items-center ${inline ? '' : compact ? 'gap-2' : 'gap-4'} min-w-0`}>
  {!inline && (
    <div class="min-w-0">
      <p class="font-mono uppercase tracking-[0.18em] text-xs text-ledger-muted">{label}</p>
      {compact ? (
        <p class="font-mono text-sm text-ledger-text">{growth == null ? '—' : `${growth > 0 ? '+' : ''}${formatStars(growth)}`} net stars</p>
      ) : first && last && (
        <>
          <p class="text-sm text-ledger-text">{total.toLocaleString('en-US')} {noun} added across {days.length} days</p>
          <p class="text-xs text-ledger-whisper mt-1">Daily additions for stars still present · {first.date} to {last.date}</p>
        </>
      )}
    </div>
  )}
  {inline && points.length > 0 && <span class="text-xs font-mono text-ledger-muted whitespace-nowrap mr-2" >+{formatStars(total)} / {days.length}d</span>}
  {points.length ? (
    <svg width={width} height={height} viewBox={`0 0 ${width} ${height}`} class="shrink-0 overflow-visible"
      role="img" aria-label={caption} data-star-days={points.length}>
      <title>{caption}</title>
      {segments.map(segment => segment.length === 1
        ? <circle cx={segment[0].x} cy={segment[0].y} r="2" fill={stroke} />
        : <polyline points={segment.map(p => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ')}
            fill="none" stroke={stroke} stroke-width={inline ? 1.8 : 2} stroke-linecap="round" stroke-linejoin="round" />)}
      {points.length > 1 && <circle cx={points[points.length - 1].x} cy={points[points.length - 1].y} r="2" fill={stroke} />}
      {!inline && points.map(point => {
        const step = (width - 2 * pad) / Math.max(1, span);
        return <rect x={point.x - step / 2} y="0" width={step} height={height} fill="transparent">
          <title>{point.date} · {point.stars.toLocaleString('en-US')} stars</title>
        </rect>;
      })}
    </svg>
  ) : <span class="text-xs text-ledger-faint" title={caption} aria-label={caption}>{inline ? 'No daily history' : caption}</span>}
</div>
