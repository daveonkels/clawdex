---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  canonicalUrl?: string;
  robots?: string;
  markdownUrl?: string;
  jsonUrl?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description = 'Compare OpenClaw alternatives and forks side by side — GitHub stars, language, performance, and project health. A directory of runnable AI agents.',
  ogImage = 'https://shelldex.com/images/og-default.jpg',
  ogImageAlt = 'The Shelldex lobster archivist examines shells at a tide table.',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  canonicalUrl,
  robots = 'index, follow',
  markdownUrl,
  jsonUrl,
  jsonLd,
} = Astro.props;

const resolvedCanonical = canonicalUrl === '' ? undefined : canonicalUrl || `https://shelldex.com${Astro.url.pathname}`;

// Count whole UTC calendar days; the static value remains useful without JavaScript.
const buildDay = new Date().toISOString().slice(0, 10);
const daysSinceRename = Math.floor((Date.parse(buildDay) - Date.parse('2026-01-29')) / 86400000);
const sectionParents: Record<string, string> = {projects:'/', alternatives:'/best-alternatives/', methodology:'/about/', badges:'/submit/'};
function navCurrent(path: string) {
  const here = Astro.url.pathname;
  if (here === path) return 'page';
  if ((path !== '/' && here.startsWith(path)) || sectionParents[here.split('/')[1]] === path) return 'location';
  return undefined;
}
function inferImageType(url: string): string | undefined {
  const pathname = new URL(url).pathname.toLowerCase();
  if (pathname.endsWith('.png')) return 'image/png';
  if (pathname.endsWith('.webp')) return 'image/webp';
  if (pathname.endsWith('.jpg') || pathname.endsWith('.jpeg')) return 'image/jpeg';
  return undefined;
}

const ogImageType = inferImageType(ogImage);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/space-grotesk-latin.woff2" crossorigin />
    <link rel="prefetch" as="font" type="font/woff2" href="/fonts/titan-one-latin.woff2" crossorigin />
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}

    <!-- Agent-facing discovery: RFC 8288 link relations -->
    {markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} title="Markdown version" />}
    {jsonUrl && <link rel="alternate" type="application/json" href={jsonUrl} title="JSON version" />}
    <link rel="api-catalog" href="https://shelldex.com/.well-known/api-catalog" />
    <link rel="service-desc" type="application/vnd.oai.openapi+json;version=3.1" href="https://shelldex.com/openapi.json" />
    <link rel="service-doc" type="text/markdown" href="https://shelldex.com/AGENTS.md" />
    <link rel="describedby" href="https://shelldex.com/llms.txt" />
    <link rel="author" href="https://onk.io" />
    <link rel="license" href="https://creativecommons.org/licenses/by/4.0/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Shelldex — The OpenClaw Ecosystem" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:src" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- SEO -->
    <meta name="keywords" content="shelldex, clawdex, theclawdex, openclaw alternatives, openclaw clones, openclaw forks, openclaw comparison, zeroclaw, nanoclaw, picoclaw, ironclaw, moltis, nanobot, bashobot, nullclaw, openclaw-inspired projects, personal ai agent, agentic projects, self-hosted ai agent, open source ai assistant, clawdbot alternatives" />
    <meta name="robots" content={robots} />

    <title>{title}</title>
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}
    <slot name="head" />
    <script is:inline>
      // WebMCP: expose Shelldex as browser-callable tools for agents.
      // Feature-detected; silently no-ops in browsers without navigator.modelContext.
      (function() {
        if (typeof navigator === 'undefined' || !navigator.modelContext) return;
        async function fetchJson(url) {
          var res = await fetch(url, { headers: { Accept: 'application/json' } });
          if (!res.ok) throw new Error('Shelldex fetch failed: ' + res.status + ' ' + url);
          return await res.json();
        }
        var tools = [
          {
            name: 'shelldex_search_projects',
            description: "Search the Shelldex registry of OpenClaw alternatives, forks, and derivatives. Filters by free-text query (matches name, tagline, description, categories) and by language. Returns an array of project objects with stars, GitHub stats, and metadata.",
            inputSchema: {
              type: 'object',
              properties: {
                query: { type: 'string', description: 'Free-text search (case-insensitive)' },
                language: { type: 'string', description: 'Filter to one language slug (rust, python, typescript, go, c, bash, zig, javascript, kotlin, multi)' },
                limit: { type: 'integer', default: 20, minimum: 1, maximum: 100 }
              }
            },
            execute: async function(args) {
              args = args || {};
              var data = await fetchJson('/api/projects.json');
              var results = data.projects;
              if (args.language) {
                var lang = String(args.language).toLowerCase();
                results = results.filter(function(p) { return p.language === lang; });
              }
              if (args.query) {
                var q = String(args.query).toLowerCase();
                results = results.filter(function(p) {
                  return p.name.toLowerCase().indexOf(q) !== -1
                    || p.slug.toLowerCase().indexOf(q) !== -1
                    || (p.tagline || '').toLowerCase().indexOf(q) !== -1
                    || (p.description || '').toLowerCase().indexOf(q) !== -1
                    || (p.category || []).some(function(c) { return c.toLowerCase().indexOf(q) !== -1; });
                });
              }
              var limit = Math.max(1, Math.min(100, args.limit || 20));
              return results.slice(0, limit);
            }
          },
          {
            name: 'shelldex_get_project',
            description: "Fetch the full detail record for one OpenClaw-ecosystem project by its canonical slug (lowercase, hyphen-separated; e.g., 'hermes', 'openclaw', 'zeroclaw'). Returns project metadata, GitHub stats, health score, and leaderboard rank.",
            inputSchema: {
              type: 'object',
              required: ['slug'],
              properties: { slug: { type: 'string' } }
            },
            execute: async function(args) {
              return await fetchJson('/api/projects/' + encodeURIComponent(args.slug) + '.json');
            }
          },
          {
            name: 'shelldex_get_leaderboard',
            description: "Fetch the ranked Shelldex leaderboard. Entries include stars, 7-day growth, license, and a 0-100 health score computed from last push, open issues and pull requests relative to stars, last release and measured net star growth. Historical records have no current score or rank.",
            inputSchema: {
              type: 'object',
              properties: { limit: { type: 'integer', default: 20, minimum: 1, maximum: 100 } }
            },
            execute: async function(args) {
              args = args || {};
              var data = await fetchJson('/api/leaderboard.json');
              var limit = Math.max(1, Math.min(100, args.limit || 20));
              return Object.assign({}, data, { entries: data.entries.slice(0, limit) });
            }
          },
          {
            name: 'shelldex_compare_projects',
            description: "Compare two OpenClaw-ecosystem projects side-by-side. Returns both project records plus computed key differences. Slug order does not matter — they are normalized to alphabetical canonical form internally.",
            inputSchema: {
              type: 'object',
              required: ['slugA', 'slugB'],
              properties: {
                slugA: { type: 'string' },
                slugB: { type: 'string' }
              }
            },
            execute: async function(args) {
              var pair = [args.slugA, args.slugB].sort().join('-vs-');
              return await fetchJson('/api/compare/' + encodeURIComponent(pair) + '.json');
            }
          }
        ];
        try {
          if (typeof navigator.modelContext.provideContext === 'function') {
            navigator.modelContext.provideContext({ tools: tools });
          } else if (typeof navigator.modelContext.registerTools === 'function') {
            navigator.modelContext.registerTools(tools);
          }
        } catch (e) { /* incompatible WebMCP shape; ignore */ }
      })();
    </script>
  </head>
  <body class="bg-ledger-bg text-ledger-text font-body antialiased min-h-screen flex flex-col overflow-x-clip">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav aria-label="Main navigation" class="site-nav sticky top-0 z-50 bg-ledger-bg/90 backdrop-blur-md border-b border-ledger-border">
      <div class="max-w-[72rem] mx-auto px-5 sm:px-8">
        <div class="flex items-center justify-between h-14 sm:h-16">
          <a href="/" aria-current={navCurrent('/')} aria-label="Shelldex home" class="brand-home no-underline flex items-center gap-2.5 group">
            <span class="text-2xl group-hover:rotate-12 transition-transform duration-300">🦞</span>
            <span
              style="font-family: 'Titan One', sans-serif; letter-spacing: 0.04em;"
              class="text-xl text-ledger-red"
            >shelldex</span>
          </a>
          <div class="flex items-center gap-1">
            <div class="hidden lg:flex items-center">
              <a href="/leaderboard/" aria-current={navCurrent('/leaderboard/')} class="px-3 py-1.5 text-sm font-medium text-ledger-muted hover:text-ledger-red transition-colors rounded-md hover:bg-ledger-red-bg">Leaderboard</a>
              <a href="/compare/" aria-current={navCurrent('/compare/')} class="px-3 py-1.5 text-sm font-medium text-ledger-muted hover:text-ledger-red transition-colors rounded-md hover:bg-ledger-red-bg">Compare</a>
              <a href="/analysis/" aria-current={navCurrent('/analysis/')} class="px-3 py-1.5 text-sm font-medium text-ledger-muted hover:text-ledger-red transition-colors rounded-md hover:bg-ledger-red-bg">Analysis</a>
              <a href="/ideas/" aria-current={navCurrent('/ideas/')} class="px-3 py-1.5 text-sm font-medium text-ledger-muted hover:text-ledger-red transition-colors rounded-md hover:bg-ledger-red-bg">Ideas</a>
              <a href="/faq/" aria-current={navCurrent('/faq/')} class="px-3 py-1.5 text-sm font-medium text-ledger-muted hover:text-ledger-red transition-colors rounded-md hover:bg-ledger-red-bg">FAQ</a>
              <a href="/best-alternatives/" aria-current={navCurrent('/best-alternatives/')} class="px-3 py-1.5 text-sm font-medium text-ledger-muted hover:text-ledger-red transition-colors rounded-md hover:bg-ledger-red-bg">Alternatives</a>
            </div>
            <div class="flex items-center gap-2 ml-2">
              <a
                href="/submit/" aria-current={navCurrent('/submit/')}
                class="hidden lg:inline-flex items-center gap-1.5 px-3.5 py-1.5 text-sm font-semibold text-ledger-text border border-ledger-border-strong hover:bg-ledger-surface rounded-md transition-colors"
              >Submit</a>
              <a
                href="https://x.com/everyshell"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Shelldex on X"
                class="text-ledger-faint hover:text-ledger-text transition-colors flex items-center p-1.5"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932zM17.61 20.644h2.039L6.486 3.24H4.298z"/></svg>
              </a>
              <!-- Mobile hamburger -->
              <button
                id="mobile-menu-btn"
                type="button"
                aria-label="Toggle menu"
                aria-expanded="false" aria-controls="mobile-menu"
                class="lg:hidden flex items-center justify-center w-11 h-11 text-ledger-muted hover:text-ledger-red transition-colors"
              >
                <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
                <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
          </div>
        </div>
        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden lg:hidden border-t border-ledger-border pb-3 pt-1.5">
          <a href="/leaderboard/" aria-current={navCurrent('/leaderboard/')} class="block px-3 py-2 text-sm text-ledger-muted hover:text-ledger-red hover:bg-ledger-red-bg rounded-md">Leaderboard</a>
          <a href="/compare/" aria-current={navCurrent('/compare/')} class="block px-3 py-2 text-sm text-ledger-muted hover:text-ledger-red hover:bg-ledger-red-bg rounded-md">Compare</a>
          <a href="/analysis/" aria-current={navCurrent('/analysis/')} class="block px-3 py-2 text-sm text-ledger-muted hover:text-ledger-red hover:bg-ledger-red-bg rounded-md">Analysis</a>
          <a href="/ideas/" aria-current={navCurrent('/ideas/')} class="block px-3 py-2 text-sm text-ledger-muted hover:text-ledger-red hover:bg-ledger-red-bg rounded-md">Ideas</a>
          <a href="/faq/" aria-current={navCurrent('/faq/')} class="block px-3 py-2 text-sm text-ledger-muted hover:text-ledger-red hover:bg-ledger-red-bg rounded-md">FAQ</a>
          <a href="/best-alternatives/" aria-current={navCurrent('/best-alternatives/')} class="block px-3 py-2 text-sm text-ledger-muted hover:text-ledger-red hover:bg-ledger-red-bg rounded-md">Alternatives</a>
          <a href="/submit/" aria-current={navCurrent('/submit/')} class="block px-3 py-2 text-sm font-semibold text-ledger-red hover:bg-ledger-red-bg rounded-md">Submit a Project</a>
        </div>
      </div>
      <script is:inline>
        (function() {
          var btn = document.getElementById('mobile-menu-btn');
          var menu = document.getElementById('mobile-menu');
          var iconOpen = document.getElementById('menu-icon-open');
          var iconClose = document.getElementById('menu-icon-close');
          if (btn && menu && iconOpen && iconClose) {
            document.addEventListener('keydown', function(event) {
              if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {btn.click(); btn.focus();}
            });
            btn.addEventListener('click', function() {
              var expanded = btn.getAttribute('aria-expanded') === 'true';
              btn.setAttribute('aria-expanded', String(!expanded));
              menu.classList.toggle('hidden');
              iconOpen.classList.toggle('hidden');
              iconClose.classList.toggle('hidden');
            });
          }
        })();
      </script>
    </nav>

    <main id="main-content" tabindex="-1" class="flex-1 min-w-0">
      <slot />
    </main>

    <footer class="border-t border-ledger-border mt-16">
      <div class="max-w-[72rem] mx-auto px-5 sm:px-8 py-10 sm:py-14">
        <div class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-8 items-start">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg">🦞</span>
              <span style="font-family: 'Titan One', sans-serif; letter-spacing: 0.04em;" class="text-ledger-red">shelldex</span>
            </div>
            <p class="text-sm text-ledger-faint italic max-w-xs" id="footer-tagline">Every shell in the sea.</p>
            <script is:inline>
              (function() {
                var taglines = [
                  'Every shell in the sea.',
                  'Cataloging the ecosystem before it molts again.',
                  'Somebody had to keep track. We drew the short claw.',
                  'None of these are affiliated with actual lobsters. Probably.',
                ];
                var el = document.getElementById('footer-tagline');
                if (el) el.textContent = taglines[Math.floor(Math.random() * taglines.length)];
              })();
            </script>
          </div>
          <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-1.5 text-sm text-ledger-faint">
            <a href="/" class="hover:text-ledger-red transition-colors">Directory</a>
            <a href="/leaderboard/" class="hover:text-ledger-red transition-colors">Leaderboard</a>
            <a href="/compare/" class="hover:text-ledger-red transition-colors">Compare</a>
            <a href="/analysis/" class="hover:text-ledger-red transition-colors">Analysis</a>
            <a href="/methodology/" class="hover:text-ledger-red">Methodology &amp; corrections</a>
            <a href="/ideas/" class="hover:text-ledger-red">Ideas</a>
            <a href="/faq/" class="hover:text-ledger-red">FAQ</a>
            <a href="/about/" class="hover:text-ledger-red transition-colors">About</a>
            <a href="/submit/" class="hover:text-ledger-red transition-colors">Submit</a>
          </nav>
        </div>
        <div class="border-t border-ledger-border mt-8 pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <p class="text-xs text-ledger-whisper">
            A project by <a href="https://onk.io" class="underline decoration-ledger-border hover:text-ledger-red transition-colors">Dave Onkels</a>.
            Inspired by <a href="https://github.com/openclaw/openclaw" class="underline decoration-ledger-border hover:text-ledger-red transition-colors">OpenClaw</a>.
          </p>
          <p class="text-xs text-ledger-whisper">
            <span id="rebrand-days">{daysSinceRename}</span> days since the <a href="/about/#timeline" class="underline">OpenClaw rename</a>.
            <script is:inline>
              document.getElementById('rebrand-days').textContent = String(Math.floor((Date.now() - Date.parse('2026-01-29')) / 86400000));
            </script>
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/fonts.css';
  @import '../styles/editorial-system.css';
  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  ::-webkit-scrollbar { width: 8px; }
  ::-webkit-scrollbar-track { background: #f8f4ed; }
  ::-webkit-scrollbar-thumb { background: #d4c8ba; border-radius: 999px; }
  ::-webkit-scrollbar-thumb:hover { background: #c73b20; }

  ::selection {
    background: rgba(199, 59, 32, 0.15);
    color: #1c1410;
  }

  .v2-ticker-track {
    display: flex;
    gap: 0.5rem;
    width: max-content;
    animation: v2-ticker 60s linear infinite;
    will-change: transform;
  }
  @keyframes v2-ticker {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .v2-ticker-track { animation-play-state: paused; }
  }
.site-nav [aria-current]:not(.brand-home){text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:.36em}
  .site-nav a,.site-nav button{min-height:44px;align-content:center}
  .skip-link{position:fixed;top:.4rem;left:.6rem;z-index:100;background:white;color:#1c1410;padding:.7rem;transform:translateY(-160%)}
  .skip-link:focus{transform:none}
  :is(a,button,input,select,summary,textarea,[tabindex]):focus-visible{outline:2px solid #1c1410!important;outline-offset:3px}
  :where(main) [id]{scroll-margin-top:5rem}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
</style>
